# Default Compose stack uses synthetic SQL data and a labelled scripted planner.
CONTRACTSQL_DB_PASSWORD=local-demo-password
# Optional real planner; configure both fields to enable it.
CONTRACTSQL_PLANNER_PROVIDER=ollama
CONTRACTSQL_PLANNER_BASE_URL=
CONTRACTSQL_PLANNER_MODEL=
CONTRACTSQL_PLANNER_TIMEOUT_SECONDS=30
# API key JSON may override Compose's local demo credentials.
# For registered datasets outside Compose, set CONTRACTSQL_SQL_TASKS to tasks.json.
# Optional local Qwen3 reasoning profile (SQL text; no automatic JSON checker):
# CONTRACTSQL_PLANNER_MODEL=qwen3:14b
# CONTRACTSQL_SQL_GENERATION_FORMAT=sql
# CONTRACTSQL_PLANNER_THINKING=true
# CONTRACTSQL_PLANNER_MAX_TOKENS=8192
# CONTRACTSQL_PLANNER_TIMEOUT_SECONDS=120
# The local launcher supplies these together via:
# python scripts/local_demo.py start --model qwen3:14b --generation-format sql --thinking
