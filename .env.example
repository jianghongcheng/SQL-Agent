# Default Compose stack uses synthetic SQL data and a labelled scripted planner.
RADMEASURE_DB_PASSWORD=local-demo-password
# Optional real planner; configure both fields to enable it.
RADMEASURE_PLANNER_PROVIDER=ollama
RADMEASURE_PLANNER_BASE_URL=
RADMEASURE_PLANNER_MODEL=
RADMEASURE_PLANNER_TIMEOUT_SECONDS=30
# API key JSON may override Compose's local demo credentials.
# For registered datasets outside Compose, set RADMEASURE_SQL_TASKS to tasks.json.
# Optional local Qwen3 reasoning profile (SQL text; no automatic JSON checker):
# RADMEASURE_PLANNER_MODEL=qwen3:14b
# RADMEASURE_SQL_GENERATION_FORMAT=sql
# RADMEASURE_PLANNER_THINKING=true
# RADMEASURE_PLANNER_MAX_TOKENS=8192
# RADMEASURE_PLANNER_TIMEOUT_SECONDS=120
# The local launcher supplies these together via:
# python scripts/local_demo.py start --model qwen3:14b --generation-format sql --thinking
