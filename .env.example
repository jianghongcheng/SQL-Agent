# Default Compose stack uses synthetic SQL data and a labelled scripted planner.
SQL_AGENT_DB_PASSWORD=local-demo-password
# Optional real planner; configure both fields to enable it.
SQL_AGENT_PLANNER_PROVIDER=ollama
SQL_AGENT_PLANNER_BASE_URL=
SQL_AGENT_PLANNER_MODEL=
SQL_AGENT_PLANNER_TIMEOUT_SECONDS=30
# API key JSON may override Compose's local demo credentials.
# For registered datasets outside Compose, set SQL_AGENT_SQL_TASKS to tasks.json.
# Optional local Qwen3 reasoning profile (SQL text; no automatic JSON checker):
# SQL_AGENT_PLANNER_MODEL=qwen3:14b
# SQL_AGENT_SQL_GENERATION_FORMAT=sql
# SQL_AGENT_PLANNER_THINKING=true
# SQL_AGENT_PLANNER_MAX_TOKENS=8192
# SQL_AGENT_PLANNER_TIMEOUT_SECONDS=120
# The local launcher supplies these together via:
# python scripts/local_demo.py start --model qwen3:14b --generation-format sql --thinking
